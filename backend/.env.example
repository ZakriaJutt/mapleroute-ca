# Copy to backend/.env (gitignored) and fill in. Names only; no values are committed.
# The process environment overrides this file. All settings are read in core.config.
MAPLEROUTE_IDENTITY_PROVIDERS=local
# Mail. Local: Mailpit at 127.0.0.1:1025, no authentication. Production: provider host, STARTTLS, credentials.
MAPLEROUTE_SMTP_HOST=
MAPLEROUTE_SMTP_PORT=
MAPLEROUTE_SMTP_STARTTLS=
MAPLEROUTE_SMTP_USERNAME=
MAPLEROUTE_SMTP_PASSWORD=
MAPLEROUTE_MAIL_FROM=
# Object storage. Local: MinIO endpoint, region us-east-1. Production: no endpoint, region ca-central-1 (MH-11).
MAPLEROUTE_S3_ENDPOINT_URL=
MAPLEROUTE_S3_REGION=
MAPLEROUTE_S3_BUCKET=
MAPLEROUTE_S3_ACCESS_KEY_ID=
MAPLEROUTE_S3_SECRET_ACCESS_KEY=
